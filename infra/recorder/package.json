{
  "name": "@pa-webinar/multitrack-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "Multitrack per-participant audio recorder for Jitsi events (ADR-013, Fase 3). Headless-Chrome bot that records one audio track per participant for exact speaker attribution.",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "puppeteer": "^25.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "postcss": "^8.5.29",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "8.1.5"
  }
}
