# Copia in terraform.tfvars (ignorato da git) e adatta. Solo project_id,
# i due nomi DNS e master_authorized_networks sono obbligatori.

project_id = "<project-id>"
region     = "europe-west8"

portal_hostname     = "webinar.example.com"
conference_hostname = "meet.webinar.example.com"
turn_hostname       = "turn.webinar.example.com"

# Zona Cloud DNS dello stesso progetto; vuoto = i record li crei tu.
dns_managed_zone = ""

# Chi può parlare con l'API del cluster.
master_authorized_networks = [
  { cidr_block = "<admin-cidr>", display_name = "amministratori" },
]

# Scelte (vedi README.md, "Choices").
ingress_mode = "gce"           # oppure "nginx"
jvb_exposure = "load_balancer" # oppure "node_public_ip"
turn_enabled = false           # true insieme al coturn di values-gke.yaml

jvb_pool = {
  machine_type = "n2-standard-4"
  max_nodes    = 4
}

jibri_enabled = false
gpu_enabled   = false
